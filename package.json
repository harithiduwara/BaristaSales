{
  "name": "aluthgama-daily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aluthgama Daily Report – daily sales reporting app (REQUIREMENTS.md)",
  "workspaces": [
    "packages/shared",
    "backend",
    "apps/web",
    "tools/mock-api"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p packages/shared && tsc -p backend && tsc -p apps/web && tsc -p apps/web/tsconfig.node.json && tsc -p tools/mock-api",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mock": "npm test -w @aluthgama/mock-api",
    "test:e2e": "npm run test:e2e -w apps/web",
    "build:web": "npm run build -w apps/web",
    "build:backend": "npm run build -w backend",
    "dev": "npm run dev -w apps/web",
    "mock": "npm start -w @aluthgama/mock-api"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
